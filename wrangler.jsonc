{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-ui",
  "compatibility_date": "2026-05-22",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
